# Instance identity — every installation (integrator or site) sets its own values.
APP_ENV=development
INSTANCE_ID=00000000-0000-0000-0000-000000000000
INSTANCE_TYPE=integrator
APP_VERSION=0.1.0
TIMEZONE=UTC
LOG_LEVEL=INFO

# Database — each installation uses its own PostgreSQL database. Never shared
# between integrator and site.
DATABASE_URL=postgresql+asyncpg://news_platform:change-me@localhost:5432/news_platform

# Redis — queues, locks and short-lived cache only. Not authoritative storage.
REDIS_URL=redis://localhost:6379/0

# Integrator delivery safety. The outer attempt budget is durable across worker
# restarts; exhausted deliveries move to the dead-letter queue.
DELIVERY_MAX_ATTEMPTS=10
DELIVERY_RETRY_BACKOFF_SECONDS=30

# AI provider routing. Secrets are supplied only at runtime and must never be
# committed. Keep `fake` for offline development; production may use
# `openai,fake` to retain a deterministic fallback.
AI_PROVIDERS=fake
AI_MAX_ATTEMPTS_PER_PROVIDER=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
YOUTUBE_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
# Configure current contract rates explicitly; zero means cost is recorded as unknown/zero.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0

# Public Web + Admin UI. Browser sessions terminate in the Next.js BFF; the
# service token is used only for server-to-server admin API requests.
NEXT_PUBLIC_SITE_NAME=Signal Desk
NEXT_PUBLIC_WEB_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_API_TOKEN=change-me-admin-api-token
SESSION_SECRET=change-me-session-secret
# Must be true behind production HTTPS. Local HTTP Compose keeps it false.
SESSION_COOKIE_SECURE=false

# Object storage — MinIO locally, any S3-compatible endpoint in production.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=change-me
S3_REGION=us-east-1
SUPABASE_DASHBOARD_URL=
SUPABASE_DASHBOARD_KEY=
DASHBOARD_RETRY_BASE_SECONDS=30
MEDIA_UPLOAD_MAX_BYTES=10485760
MEDIA_ATTEMPTS_PER_PROVIDER=2

# Distribution credentials are resolved by an explicit reference stored on
# the channel (for example DEV_TELEGRAM -> this environment variable). Tokens
# are never returned by Admin API or stored in PostgreSQL.
DISTRIBUTION_SECRET_DEV_TELEGRAM=
TELEGRAM_BASE_URL=https://api.telegram.org
# OAuth access tokens are referenced by a channel credential_ref and injected
# only into the distribution worker (for example FACEBOOK -> secret below).
DISTRIBUTION_SECRET_FACEBOOK=
DISTRIBUTION_SECRET_INSTAGRAM=
DISTRIBUTION_SECRET_TIKTOK=
DISTRIBUTION_SECRET_X=
DISTRIBUTION_SECRET_YOUTUBE=
FACEBOOK_BASE_URL=https://graph.facebook.com/v22.0
TIKTOK_BASE_URL=https://open.tiktokapis.com
X_BASE_URL=https://api.x.com
YOUTUBE_BASE_URL=https://www.googleapis.com
DISTRIBUTION_WORKER_BATCH_SIZE=25
DISTRIBUTION_WORKER_POLL_SECONDS=10
DISTRIBUTION_HTTP_TIMEOUT_SECONDS=10
DISTRIBUTION_RETRY_BASE_SECONDS=30
