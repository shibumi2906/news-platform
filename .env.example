# Instance identity — every installation (integrator or site) sets its own values.
APP_ENV=development
INSTANCE_ID=00000000-0000-0000-0000-000000000000
INSTANCE_TYPE=integrator
APP_VERSION=0.1.0
TIMEZONE=UTC
LOG_LEVEL=INFO

# Database — each installation uses its own PostgreSQL database. Never shared
# between integrator and site.
DATABASE_URL=postgresql+asyncpg://news_platform:change-me@localhost:5432/news_platform

# Redis — queues, locks and short-lived cache only. Not authoritative storage.
REDIS_URL=redis://localhost:6379/0

# Object storage — MinIO locally, any S3-compatible endpoint in production.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=change-me
