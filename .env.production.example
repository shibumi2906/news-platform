# Copy to an operator-controlled secret store or local .env.production; never commit values.
APP_ENV=production
APP_VERSION=0.1.0
# Persist these UUIDs across every redeploy. Never reuse one between services.
INTEGRATOR_INSTANCE_ID=<new-integrator-uuid>
SITE_INSTANCE_ID=<new-site-uuid>
TIMEZONE=UTC
API_ALLOWED_HOSTS=api.example.com
WEB_ORIGIN=https://www.example.com
WEB_DOMAIN=www.example.com
SITE_API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
POSTGRES_INTEGRATOR_PASSWORD=<secret>
POSTGRES_SITE_PASSWORD=<secret>
REDIS_PASSWORD=<secret>
MINIO_ROOT_USER=<non-secret-access-key>
MINIO_ROOT_PASSWORD=<secret>
ADMIN_API_TOKEN=<32+ character service secret>
ADMIN_SESSION_KEYS=k1:<32+ character session signing secret>
ADMIN_BOOTSTRAP_USERNAME=<first-admin-username>
ADMIN_BOOTSTRAP_PASSWORD=<12+ character first-admin-password>
AI_PROVIDERS=openai
OPENAI_API_KEY=<secret>
OPENAI_MODEL=<chosen-model>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY=<secret>
S3_SECRET_KEY=<secret>
S3_BUCKET=<site-private-bucket>
S3_REGION=us-east-1
MEDIA_UPLOAD_MAX_BYTES=10485760
NEXT_PUBLIC_WEB_URL=https://www.example.com
NEXT_PUBLIC_PORTAL_THEME=editorial
SESSION_COOKIE_SECURE=true
# Optional dashboard export: set both or neither.
SUPABASE_DASHBOARD_URL=
SUPABASE_DASHBOARD_KEY=
# Optional distribution channels: set only for channels configured in Admin.
DISTRIBUTION_SECRET_TELEGRAM=
DISTRIBUTION_SECRET_FACEBOOK=
DISTRIBUTION_SECRET_INSTAGRAM=
DISTRIBUTION_SECRET_TIKTOK=
DISTRIBUTION_SECRET_X=
DISTRIBUTION_SECRET_YOUTUBE=
# Advertising requires no deployment secret; campaigns are configured in Site Admin.
# Payments: Optional. Not required for platform startup. Configure provider-specific
# namespaced secrets only after OD-09; leave this section empty for the first launch.
