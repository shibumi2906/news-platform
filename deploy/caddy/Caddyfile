{
  email {$ACME_EMAIL}
}
{$WEB_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
  handle /integrator-api/api/v1/site-feed/materials {
    uri strip_prefix /integrator-api
    request_body {
      max_size 16KB
    }
    reverse_proxy integrator-api:8000 {
      header_up Host integrator-api
    }
  }
  reverse_proxy public-web:3000
}
{$SITE_API_DOMAIN} {
  request_body {
    max_size 12MB
  }
  reverse_proxy site-api:8000
}
